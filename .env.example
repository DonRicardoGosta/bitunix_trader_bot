# =============================================================================
# Bitunix Trader - környezeti változók sablon / Environment template
# =============================================================================
# Másold át .env-be:  cp .env.example .env
# Copy to .env:       cp .env.example .env
# =============================================================================

# --- Általános / General ---
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
TZ=UTC

# --- PostgreSQL ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bitunix_trader
POSTGRES_HOST=db
POSTGRES_PORT=5432
# A backend ezt használja közvetlenül / Backend uses this directly:
DATABASE_URL=postgresql+asyncpg://trader:change_me_in_production@db:5432/bitunix_trader

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=please-generate-a-long-random-string-min-64-chars

# --- Bitunix API hitelesítő adatok / credentials ---
# Generáld őket itt / Generate them at:
#   https://www.bitunix.com/account/apiManagement
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_REST_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC_URL=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE_URL=wss://fapi.bitunix.com/private/

# Biztonsági kapcsoló: csak akkor enged élő rendelést küldeni, ha true.
# Safety switch: live order placement is only enabled when true.
BITUNIX_LIVE_TRADING=false
BITUNIX_MARGIN_COIN=USDT

# --- Stratégia / Scheduler ---
# Automatikus stratégia futtatás kapcsolója (kézi indítás mindig elérhető API-n)
STRATEGY_RUNNER_ENABLED=false
# Két lefutás között eltelő idő másodpercben
STRATEGY_INTERVAL_SECONDS=300

# Top movers stratégia paraméterei
STRATEGY_TOP_MOVERS_ENABLED=true
STRATEGY_TOP_MOVERS_COUNT=3
STRATEGY_TOP_MOVERS_COOLDOWN_MINUTES=240

# Globális kockázat: margin = max(pct × balance, min_usdt)
STRATEGY_MARGIN_PCT_OF_BALANCE=0.01
STRATEGY_MIN_MARGIN_USDT=0.25

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Bitunix Trader
