# =============================================================================
# Bitunix Trader - környezeti változók sablon / Environment template
# =============================================================================
# Másold át .env-be:  cp .env.example .env
# Copy to .env:       cp .env.example .env
# =============================================================================

# --- Általános / General ---
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
TZ=UTC

# --- PostgreSQL ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bitunix_trader
POSTGRES_HOST=db
POSTGRES_PORT=5432
# A backend ezt használja közvetlenül / Backend uses this directly:
DATABASE_URL=postgresql+asyncpg://trader:change_me_in_production@db:5432/bitunix_trader

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Vesszővel elválasztott URL-ek (nem JSON tömb – Alembic/Docker kompatibilitás).
# Comma-separated URLs (not a JSON array — avoids pydantic-settings parse errors).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=please-generate-a-long-random-string-min-64-chars

# --- Bitunix API hitelesítő adatok / credentials ---
# Generáld őket itt / Generate them at:
#   https://www.bitunix.com/account/apiManagement
BITUNIX_API_KEY=722e7f86152a4b8f76cf17a68bcd3e5f
BITUNIX_API_SECRET=6d4e55f2d05ae4ac76096229e281da9d
BITUNIX_REST_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC_URL=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE_URL=wss://fapi.bitunix.com/private/

# Biztonsági kapcsoló: csak akkor enged élő rendelést küldeni, ha true.
# Safety switch: live order placement is only enabled when true.
BITUNIX_LIVE_TRADING=false
BITUNIX_MARGIN_COIN=USDT

# --- Stratégia / Scheduler ---
# Automatikus stratégia futtatás (kézi indítás továbbra is elérhető API-n).
# Lokális fejlesztéshez állítsd false-ra, ha nem akarsz háttérben futó kört.
STRATEGY_RUNNER_ENABLED=true
# Két scheduler-kör között várakozás (mp). Egy körben minden stratégia lefut.
STRATEGY_INTERVAL_SECONDS=30

# Top movers stratégia paraméterei
STRATEGY_TOP_MOVERS_ENABLED=true
STRATEGY_TOP_MOVERS_COUNT=3
# Slot-feltöltés: ennyi coinig nézzük a rangsort (lezárt pozíció után a következő).
STRATEGY_TOP_MOVERS_SCAN_LIMIT=60
STRATEGY_TOP_MOVERS_COOLDOWN_MINUTES=240

# Globális kockázat: margin = max(pct × balance, min_usdt)
STRATEGY_MARGIN_PCT_OF_BALANCE=0.01
STRATEGY_MIN_MARGIN_USDT=0.25

# --- TP / SL automatikus belövő (calibration) ---
# A kalibrációs scheduler az induláskor egyszer lefut, majd óránként újra.
# Trading csak akkor engedélyezett, ha legalább egy SIKERES kalibráció van
# és az fiatalabb mint max(2 × interval, calibration_max_age_minutes).
CALIBRATION_ENABLED=true
CALIBRATION_INTERVAL_SECONDS=3600         # 1 óra
CALIBRATION_LOOKBACK_MINUTES=120          # 2 óra visszamenőleg
CALIBRATION_TOP_N=20                      # top 20 coin
CALIBRATION_KLINE_INTERVAL=1m
CALIBRATION_TP_ATR_MULT=3.0               # TP = 3 × ATR
CALIBRATION_SL_ATR_MULT=1.5               # SL = 1.5 × ATR  → R:R = 2:1
CALIBRATION_MIN_TP_MOVE_PCT=0.20
CALIBRATION_MIN_SL_MOVE_PCT=0.10
CALIBRATION_MAX_TP_MOVE_PCT=10.0
CALIBRATION_MAX_SL_MOVE_PCT=5.0
CALIBRATION_MAX_AGE_MINUTES=180
REQUIRE_CALIBRATION_FOR_TRADING=true

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Bitunix Trader

# --- Docker erőforrás-korlátok / resource limits ---
# CPU: tört érték is lehet (pl. 0.5 = fél mag), memória: M / G postfix
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=512M
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEM_LIMIT=1G
