# =============================================================================
# Bitunix Trader - környezeti változók sablon / Environment template
# =============================================================================
# Másold át .env-be:  cp .env.example .env
# Stratégia algoritmus + élő trading: DB (UI: Stratégiák / Vezérlőpult), nem env.
# =============================================================================

# --- Általános / General ---
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

# --- PostgreSQL ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bitunix_trader
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trader:change_me_in_production@db:5432/bitunix_trader

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=please-generate-a-long-random-string-min-64-chars

# --- Bitunix API ---
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_REST_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC_URL=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE_URL=wss://fapi.bitunix.com/private/
BITUNIX_MARGIN_COIN=USDT

# --- Stratégia scheduler (infra) ---
STRATEGY_RUNNER_ENABLED=true
STRATEGY_INTERVAL_SECONDS=30

# --- Kalibráció ---
CALIBRATION_ENABLED=true
CALIBRATION_INTERVAL_SECONDS=3600
CALIBRATION_LOOKBACK_MINUTES=10080
CALIBRATION_TOP_N=200
CALIBRATION_KLINE_INTERVAL=15m
CALIBRATION_TP_ATR_MULT=3.0
CALIBRATION_SL_ATR_MULT=1.5
CALIBRATION_MAX_AGE_MINUTES=180
REQUIRE_CALIBRATION_FOR_TRADING=true

# TP/SL position attach: várakozás fill után (Bitunix API késleltetés)
POSITION_TPSL_RESOLVE_MAX_ATTEMPTS=40
POSITION_TPSL_RESOLVE_DELAY_SECONDS=0.5

# --- Élő UI push ---
LIVE_UI_PUSH_ENABLED=true
LIVE_UI_PUSH_INTERVAL_SECONDS=2

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Bitunix Trader

# --- Docker erőforrás-korlátok ---
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=512M
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEM_LIMIT=1G
